# BankEase Environment Variables
# Copy this file to .env and fill in real values

# Database
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# JWT
JWT_SECRET=BankEaseSecretKeyMustBe256BitsLong_ChangeInProduction_2024!

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@bankease.com
MAIL_PASSWORD=your_app_password_here

# CORS
CORS_ORIGINS=http://localhost:4200
